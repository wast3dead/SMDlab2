<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="WeatherPatterns"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SMDlab2">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="WeatherPatterns"
            android:theme="@style/Theme.SMDlab2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".mvc.MvcActivity"
            android:exported="false"
            android:label="MVC Pattern" />

        <activity
            android:name=".mvp.MvpActivity"
            android:exported="false"
            android:label="MVP Pattern" />

        <activity
            android:name=".mvvm.MvvmActivity"
            android:exported="false"
            android:label="MVVM Pattern" />

        <activity
            android:name=".mvi.MviActivity"
            android:exported="false"
            android:label="MVI Pattern" />

    </application>

</manifest>
